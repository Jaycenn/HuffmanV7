# Non-secret Azure Container Apps environment variables.
AFC_DB_BACKEND=supabase
AFC_STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_BUCKET=artifacts

# Azure terminates HTTPS and forwards requests through one trusted proxy hop.
AFC_TRUST_PROXY=1
AFC_SECURE_COOKIES=1

# Thesis-documented limits.
AFC_MAX_FILE_SIZE=104857600
AFC_MAX_BATCH_SIZE=524288000
AFC_MAX_CONCURRENT_JOBS=1

# Application-level durable-storage policy. This is separate from Supabase's
# project-wide free-plan quota.
AFC_MAX_STORED_BYTES_PER_USER=157286400
AFC_RESULT_RETENTION_DAYS=0

# Installation identity. Store AFC_ADMIN_PASSWORD as an Azure secret.
AFC_ADMIN_USER=admin
AFC_ADMIN_EMAIL=replace-with-the-team-email

# Add these as Azure Container Apps secrets and expose each as a secret-backed
# environment variable; never commit their values:
# AFC_SECRET_KEY
# AFC_PG_DSN
# SUPABASE_SERVICE_ROLE_KEY
# AFC_ADMIN_PASSWORD
