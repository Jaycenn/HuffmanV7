# Copy to .env and fill in.  .env must stay out of git.
#
# Project Settings -> Database -> Connection string (URI).
# Replace [YOUR-PASSWORD] with the database password you saved at creation.
# If the direct host will not resolve, use the pooler string on the same page.
AFC_PG_DSN=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-REF.supabase.co:5432/postgres

# Project Settings -> API
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket created in Phase 1
SUPABASE_BUCKET=artifacts

# Which backend the app uses: sqlite (default, for tests and local dev)
# or supabase.  The 541-check suite always runs against sqlite.
AFC_DB_BACKEND=sqlite
AFC_STORAGE_BACKEND=local
